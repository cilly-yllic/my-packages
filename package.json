{
  "name": "@my-packages/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "nx run-many --target=test --all",
    "release": "npx nx release ${npm_config_release:-patch} --projects=${npm_config_name}",
    "release:all": "npx nx release ${npm_config_release:-patch}",
    "build": "nx run-many --target=output --all",
    "exec:i": "npx nx exec --cwd=packages/${npm_config_name} -- npm install",
    "add:library": "npx nx g @nx/js:lib --directory=packages/${npm_config_name} --bundler=tsc --importPath=${npm_config_name} --linter=eslint --name=${npm_config_name} --publishable --unitTestRunner=vitest --strict --useProjectJson --config=project --buildable --testEnvironment=node",
    "g:plugin": "npx nx g plugin --name=${npm_config_name} --directory=plugins/${npm_config_name} --importPath=${npm_config_name} --linter=eslint --useProjectJson --unitTestRunner=vitest",
    "g:executor": "npx nx g @nx/plugin:executor --name=${npm_config_name} --path=plugins/${npm_config_plugin}/src/executors/${npm_config_name}/executor --unitTestRunner=vitest",
    "===== formatter =====": "",
    "lint": "nx lint",
    "lint:all": "nx run-many --all --target=lint --skip-nx-cache",
    "prettier": "nx format:write --all",
    "prettier:check": "nx format:check --all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "24.0.2",
    "@nx/eslint-plugin": "24.0.2",
    "@nx/js": "24.0.2",
    "@nx/plugin": "24.0.2",
    "@nx/vite": "24.0.2",
    "@nx/vitest": "24.0.2",
    "@nx/web": "24.0.2",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@swc/helpers": "0.5.23",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "2.7.0",
    "jsdom": "^30.1.3",
    "jsonc-eslint-parser": "^3.3.0",
    "nx": "24.0.2",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "verdaccio": "6.11.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "dependencies": {
    "@nx/devkit": "24.0.2",
    "fs-extra": "^11.4.1",
    "minimatch": "^11.0.3"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "overrides": {
    "nx": {
      "undici": "7.30.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
